# Copiá este archivo a `.env` y completá los valores. Nunca se commitea `.env`.

# --- Base de datos (Postgres: Neon en producción, local en desarrollo) ---
# URL pooled: la usa el dashboard (`@neondatabase/serverless`).
DATABASE_URL=postgresql://postgres@127.0.0.1:5499/sereno
# URL directa (sin pooler): la usan el bot (`pg.Pool`, máximo 4 conexiones) y las migraciones.
DATABASE_URL_UNPOOLED=postgresql://postgres@127.0.0.1:5499/sereno
# Base de prueba para los tests de `@sereno/db` (se vacía en cada corrida; nunca la de producción).
DATABASE_URL_TEST=postgresql://postgres@127.0.0.1:5499/sereno_test
# Base de prueba de los tests del bot (aparte, para no chocar con los de `@sereno/db`).
DATABASE_URL_TEST_BOT=postgresql://postgres@127.0.0.1:5499/sereno_bot_test
# Base de prueba de los scripts del dashboard (seed:user, seed:demo): sin ella esos tests se saltean.
DATABASE_URL_TEST_WEB=postgresql://postgres@127.0.0.1:5499/sereno_web_test

# --- Acceso al dashboard (Better Auth) ---
# Secreto para firmar sesiones: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# URL pública del dashboard, sin barra final (en desarrollo: http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000
# Lista blanca de emails con acceso, en minúsculas y separados por coma.
ALLOWED_EMAILS=
# OAuth de Google (opcional: sin estas dos, el botón "Entrar con Google" no aparece).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Contraseña del usuario autorizado; la lee el script de seed para el acceso con email + contraseña.
DASHBOARD_PASSWORD=

# --- Bot ---
# Nivel de log de pino: trace | debug | info | warn | error (por defecto info).
LOG_LEVEL=info
# Opcionales: una clave de Binance de SÓLO LECTURA trae el mmr y las comisiones reales de
# tu cuenta (ver "Clave de Binance de sólo lectura" en el README). Vacías, el bot usa los supuestos.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Opcionales: para apuntar el bot a un Binance falso en desarrollo. Por defecto
# https://fapi.binance.com y wss://fstream.binance.com/market/stream (sólo vale la ruta /market/).
# BINANCE_REST_URL=
# BINANCE_WS_URL=

# --- Plata real (la sesión que opera futuros USDT-M de verdad) ---
# Claves de OPERACIÓN, aparte de las de sólo lectura de arriba: con futuros habilitados, SIN
# retiros y (en mainnet) restringidas por IP. El bot nunca las muestra ni las guarda.
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=
# La operación con plata real se prende sólo con `on`, exactamente (ON, 1 o true no prenden).
# Sin esta variable, una sesión real abierta sigue cuidando lo abierto pero no abre nada.
SERENO_REAL_TRADING=
# testnet | mainnet. Vacía = testnet: para operar con plata de verdad hay que escribir mainnet.
BINANCE_ENV=
