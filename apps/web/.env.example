# Variables del dashboard. Copiá este archivo a `apps/web/.env.local` (Next.js lo lee
# solo y nunca se commitea). En Vercel van en el proyecto `sereno`.

# Postgres. En desarrollo, la base local; en producción, la URL pooled de Neon.
DATABASE_URL=postgresql://postgres@127.0.0.1:5499/sereno

# Secreto para firmar sesiones: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# URL pública del dashboard, sin barra final.
BETTER_AUTH_URL=http://localhost:3000
# Emails con acceso, separados por coma (no distingue mayúsculas).
ALLOWED_EMAILS=

# OAuth de Google (opcional: sin estas dos el botón "Entrar con Google" no aparece).
# Callback a registrar en Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Herramientas de desarrollo (sólo local, nunca en Vercel).
# Contraseña del usuario de `pnpm db:seed-user`; si falta, el script genera una y la
# escribe acá. Los datos de demostración (`pnpm demo`) sólo van a bases *_dev o *_test.
DASHBOARD_PASSWORD=
